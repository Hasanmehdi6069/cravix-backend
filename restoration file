                            <span id="dynamicItemTotal">₹0</span>
                        </div>
                        <div class="bill-row grand-total">
                            <span>TO PAY</span>
                            <span id="dynamicGrandTotal">₹0</span>
                        </div>
                    </div>
                </div>
            </div>

        </div> 
        
        <!-- Address Modal -->
        <div class="modal-overlay" id="addressModal">
            <div class="modal-content">
                <div class="modal-header">
                    <h3>Add Delivery Address</h3>
                    <button class="close-modal-btn" id="closeAddressModal">&times;</button>
                </div>
                <div class="modal-body">
                    <input type="text" id="newAddressName" placeholder="Full Name (e.g. John Doe)">
                    <div style="display: flex; gap: 15px;">
                        <input type="text" id="newAddressTag" placeholder="Tag (e.g. Home, Work)" style="width: 40%;">
                        <input type="text" id="newPhone" placeholder="Mobile Number" style="width: 60%;">
                    </div>
                    <input type="text" id="newAddressLine1" placeholder="Flat, House no., Building, Company">
                    <input type="text" id="newAddressLine2" placeholder="Area, Street, Sector, Village">
                    <button class="save-address-btn" id="saveNewAddressBtn">Save Address & Proceed</button>
                </div>
            </div>
        </div>
    </main>
            
    <script src="script.js"></script>
</body>
</html>

